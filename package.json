{
  "name": "slack-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Slack using SSE for web deployment",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "npm install --build-from-source && tsc",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "@slack/web-api": "latest",
    "dotenv": "latest",
    "express": "latest",
    "sqlite3": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/sqlite3": "latest",
    "typescript": "latest"
  }
}
